    },
    {
      "label": "ESP-IDF: Flash + Monitor",
      "type": "shell",
      "command": ". /home/russan/.espressif/v6.0.2/esp-idf/export.sh >/dev/null && idf.py flash monitor",
      "problemMatcher": []
    },
    {
      "label": "ESP-IDF: Menuconfig",
      "type": "shell",
      "command": ". /home/russan/.espressif/v6.0.2/esp-idf/export.sh >/dev/null && idf.py menuconfig",
      "problemMatcher": []
    }
  ]
