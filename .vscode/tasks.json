{
  "version": "2.0.0",
  "options": {
    "env": {
      "IDF_PATH": "/home/russan/.espressif/v6.0.2/esp-idf"
    }
  },
  "tasks": [
    {
      "label": "ESP-IDF: Build",
      "type": "shell",
      "command": ". /home/russan/.espressif/v6.0.2/esp-idf/export.sh >/dev/null && idf.py build",
      "group": { "kind": "build", "isDefault": true },
